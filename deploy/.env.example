# Copy to deploy/.env on the host and fill in real values.
# deploy/.env is git-ignored; never commit production credentials.

FINALFOLIO_SMTP_HOST=mail.finalfolio.com
FINALFOLIO_SMTP_PORT=465
FINALFOLIO_SMTP_USER=noreply@finalfolio.com
FINALFOLIO_SMTP_PASS=replace-with-the-real-smtp-password
FINALFOLIO_SMTP_SECURE=ssl
FINALFOLIO_MAIL_FROM=noreply@finalfolio.com
FINALFOLIO_MAIL_FROM_NAME=FinalFolio

# Canonical origin used in verification and password-reset emails.
FINALFOLIO_PUBLIC_ORIGIN=https://finalfolio.com
FINALFOLIO_COOKIE_SECURE=true
FINALFOLIO_EVENT_RETENTION_DAYS=30
