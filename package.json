{
  "name": "finalfolio-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:mvp": "npm run build && node scripts/validate-mvp.mjs",
    "uploads:manage": "node scripts/manage-uploads.mjs",
    "uploads:backfill-variants": "node scripts/backfill-upload-variants.mjs",
    "uploads:sync-object-storage": "node scripts/sync-uploads-to-object-storage.mjs",
    "uploads:restore-local": "node scripts/restore-object-storage-local.mjs",
    "validate:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "express": "^5.1.0",
    "html-to-image": "^1.11.13",
    "jquery": "^1.12.4",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "turn.js": "^1.0.5"
  }
}
