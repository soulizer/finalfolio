{
  "name": "finalfolio-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:mvp": "npm run build && node scripts/validate-mvp.mjs",
    "uploads:manage": "node scripts/manage-uploads.mjs",
    "uploads:backfill-variants": "node scripts/backfill-upload-variants.mjs",
    "uploads:sync-object-storage": "node scripts/sync-uploads-to-object-storage.mjs",
    "uploads:restore-local": "node scripts/restore-object-storage-local.mjs",
    "validate:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5",
    "express": "^5.3.0",
    "html-to-image": "^1.11.13",
    "jquery": "^3.7.1",
    "jszip": "^3.10.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.5",
    "turn.js": "^1.0.5"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "fast-xml-parser": "^5.12.1",
    "nanoid": "^3.3.18",
    "path-to-regexp": "^8.4.0",
    "postcss": "^8.5.33",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "turn.js": {
      "jquery": "^3.7.1"
    },
    "jquery": "^3.7.1"
  }
}
